{
  "name": "Research Portal API",
  "version": "1",
  "items": [
    {
      "type": "http-request",
      "name": "01 - POST create #1",
      "request": {
        "url": "{{baseUrl}}/api/opportunities",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json",
            "enabled": true
          }
        ],
        "body": {
          "mode": "json",
          "json": "{\n  \"title\": \"Autonomous Drone Navigation\",\n  \"description\": \"Research in visual SLAM and path planning for autonomous aerial vehicles.\",\n  \"area\": \"Robotics\",\n  \"faculty_name\": \"Dr. Sarah Connor\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"ROS, Python, C++\",\n  \"available_positions\": 2,\n  \"deadline\": \"2026-12-15\"\n}"
        },
        "assertions": [
          {
            "expression": "res.status",
            "operator": "eq",
            "value": "201"
          },
          {
            "expression": "res.body.success",
            "operator": "eq",
            "value": "true"
          },
          {
            "expression": "res.body.data.id",
            "operator": "isDefined",
            "value": ""
          },
          {
            "expression": "res.body.data.status",
            "operator": "eq",
            "value": "Open"
          }
        ],
        "script": {
          "res": "bru.setVar(\"id1\", res.body.data.id);"
        }
      }
    },
