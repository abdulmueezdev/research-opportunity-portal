meta {
  name: 03 - POST create #3
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/opportunities
  body: json
  auth: none
}

body:json {
  {
    "title": "Federated Learning for Edge Devices",
    "description": "Privacy-preserving machine learning on distributed embedded systems.",
    "area": "Artificial Intelligence",
    "faculty_name": "Dr. Ada Lovelace",
    "department": "Computer Science",
    "required_skills": "PyTorch, Embedded Systems, C++",
    "available_positions": 3,
    "deadline": "2026-10-31"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.data.id: isDefined
}

script:post-response {
  bru.setVar("id3", res.body.data.id);
}
