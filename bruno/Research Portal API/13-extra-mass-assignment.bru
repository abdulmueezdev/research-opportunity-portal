meta {
  name: 13 - Extra: POST mass assignment blocked
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/opportunities
  body: json
  auth: none
}

body:json {
  {
    "id": 999,
    "title": "Quantum Error Mitigation",
    "description": "Mass assignment test attempting to force ID and created_at.",
    "area": "Quantum",
    "faculty_name": "Dr. Richard Feynman",
    "department": "Physics",
    "required_skills": "Quantum Circuits",
    "available_positions": 1,
