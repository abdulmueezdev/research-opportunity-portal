meta {
  name: 01 - POST create #1
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/opportunities
  body: json
  auth: none
}

body:json {
  {
    "title": "Autonomous Drone Navigation",
    "description": "Research in visual SLAM and path planning for autonomous aerial vehicles.",
    "area": "Robotics",
    "faculty_name": "Dr. Sarah Connor",
    "department": "Computer Science",
    "required_skills": "ROS, Python, C++",
    "available_positions": 2,
    "deadline": "2026-12-15"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.data.id: isDefined
  res.body.data.status: eq Open
}

script:post-response {
  bru.setVar("id1", res.body.data.id);
}
